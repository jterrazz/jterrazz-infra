{#
  CoreDNS split-DNS overrides for this cluster's private hostnames.

  Rendered by playbooks/tasks/platform/coredns.yml. The hostname lists live in
  playbooks/group_vars/all.yml (`private_hostnames`,
  `private_hostnames_via_traefik`) so adding a private service is a one-line
  edit there instead of a hand-maintained line in a here-doc.
#}
apiVersion: v1
kind: ConfigMap
metadata:
  name: coredns-custom
  namespace: kube-system
data:
  private-hosts.server: |
    jterrazz.com:53 {
      hosts {
{% for hostname in private_hostnames %}
        {{ tailscale_ip }} {{ hostname }}
{% endfor %}
{% for hostname in private_hostnames_via_traefik %}
        {{ traefik_cluster_ip.stdout }} {{ hostname }}
{% endfor %}
        fallthrough
      }
      forward . 1.1.1.1 9.9.9.9
    }
