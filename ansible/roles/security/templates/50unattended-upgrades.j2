// Unattended Upgrades Configuration
// Managed by Ansible (security role)
//
// Debian origin patterns. This MUST be Debian-shaped: the Ubuntu-style
// "${distro_id}:${distro_codename}-security" pattern matches NOTHING on
// Debian, because Debian's security archive publishes with
// Origin=Debian / Codename=<codename>-security / Label=Debian-Security —
// the archive is labelled `Debian-Security`, not `Debian:trixie-security`.
// With the Ubuntu pattern unattended-upgrades runs, finds zero allowed
// origins and exits successfully having installed nothing, so security
// updates stop SILENTLY. Verify with:
//   unattended-upgrade --dry-run --debug
//
// The ESM / ESMApps origins that used to be listed here are Ubuntu Pro only
// and are dead config on Debian.
Unattended-Upgrade::Origins-Pattern {
    "origin=Debian,codename=${distro_codename},label=Debian";
    "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
    "origin=Debian,codename=${distro_codename}-updates,label=Debian";
};

Unattended-Upgrade::Package-Blacklist {
};

Unattended-Upgrade::DevRelease "false";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
{% if security_auto_reboot_enabled %}
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-Time "{{ security_auto_reboot_time }}";
{% else %}
Unattended-Upgrade::Automatic-Reboot "false";
{% endif %}
