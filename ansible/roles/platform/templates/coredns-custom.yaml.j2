{#
  Rendered by roles/platform/tasks/coredns.yml from `private_hostnames` and
  `private_hostnames_via_traefik` in inventories/group_vars/all.yml.
#}
apiVersion: v1
kind: ConfigMap
metadata:
  name: coredns-custom
  namespace: kube-system
data:
  private-hosts.server: |
    jterrazz.com:53 {
      hosts {
{% for hostname in private_hostnames %}
        {{ tailscale_ip }} {{ hostname }}
{% endfor %}
{% for hostname in private_hostnames_via_traefik %}
        {{ traefik_cluster_ip.stdout }} {{ hostname }}
{% endfor %}
        fallthrough
      }
      forward . 1.1.1.1 9.9.9.9
    }
